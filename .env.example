# =============================================================
# Samudra Booking Engine — api/.env TEMPLATE
# Copy this to api/.env and fill in real values.
# NEVER commit api/.env — only this .env.example goes to git.
# =============================================================

# ----- Application -----
APP_ENV=development
# development | production

VILLA_NAME=Samudra
ADMIN_EMAIL=

# ----- SMTP (Gmail App Password) -----
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# ----- DOKU Payment Gateway -----
DOKU_ENV=sandbox
# sandbox | production
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_SHARED_KEY=
DOKU_MERCHANT_CODE=
DOKU_API_BASE_URL=
DOKU_PUBLIC_KEY=

# ----- Public URLs -----
PUBLIC_API_BASE_URL=
PUBLIC_WEB_BASE_URL=

# ----- Cloudflare Worker Secrets (set via: wrangler secret put <NAME> --env production) -----
# RESEND_API_KEY
# JWT_SECRET
# DOKU_CLIENT_ID
# DOKU_SECRET_KEY

# ----- Frontend Build Flags (in root .env or vite.config overrides) -----
VITE_FORCE_NO_CONSOLE=false
VITE_FORCE_RELATIVE_API=false
# VITE_API_BASE=https://api.example.com
# VITE_PUBLIC_BASE=/
# VITE_ADMIN_BASE=/admin
